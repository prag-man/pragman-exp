{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragman.dev/schemas/envelope.schema.json",
  "title": "Pragman CLI automation envelope",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "baseProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "schema_version": { "const": 1 },
        "data": {},
        "warnings": { "type": "array", "items": { "type": "string" } },
        "error": {}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "schema_version", "data", "warnings", "error"],
      "properties": {
        "ok": { "const": true },
        "command": { "type": "string", "minLength": 1 },
        "schema_version": { "const": 1 },
        "data": { "not": { "type": "null" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "error": { "type": "null" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "schema_version", "data", "warnings", "error"],
      "properties": {
        "ok": { "const": false },
        "command": { "type": "string", "minLength": 1 },
        "schema_version": { "const": 1 },
        "data": { "type": "null" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details", "retryable"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "message": { "type": "string", "minLength": 1 },
            "details": {},
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
