{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragman.dev/schemas/task-contract.schema.json",
  "title": "Pragman immutable task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_id", "parent_route_id", "router_depth", "request_digest", "outcome", "lane", "deliverable_kind", "execution_mode", "workspace", "project", "in_scope", "out_of_scope", "assumptions", "unresolved_conflicts", "capabilities", "providers", "provider_assignments", "provider_sequence_policy", "allowed_side_effects", "data_inputs", "effective_sensitivity", "egress_approvals", "proof", "stop_conditions", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "route_id": { "$ref": "#/$defs/uuidv7" },
    "parent_route_id": { "anyOf": [{ "$ref": "#/$defs/uuidv7" }, { "type": "null" }], "default": null },
    "router_depth": { "type": "integer", "minimum": 0, "maximum": 3 },
    "request_digest": { "$ref": "#/$defs/sha256" },
    "outcome": { "type": "string", "minLength": 1 },
    "lane": { "enum": ["fast", "standard", "deep", "operational"] },
    "deliverable_kind": { "enum": ["response-only", "local-artifact", "project-change", "external-action"] },
    "execution_mode": { "enum": ["serial", "independent-fanout"] },
    "workspace": { "anyOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
    "project": { "anyOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
    "in_scope": { "$ref": "#/$defs/stringArray", "default": [] },
    "out_of_scope": { "$ref": "#/$defs/stringArray", "default": [] },
    "assumptions": { "$ref": "#/$defs/stringArray", "default": [] },
    "unresolved_conflicts": { "$ref": "#/$defs/stringArray", "default": [] },
    "capabilities": { "$ref": "#/$defs/capabilityIdArray", "$comment": "merge: ordered-set", "default": [] },
    "providers": { "$ref": "#/$defs/providerIdArray", "default": [] },
    "provider_assignments": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/providerAssignment" }
    },
    "provider_sequence_policy": { "enum": ["stop", "continue-independent", "fallback"], "default": "stop" },
    "allowed_side_effects": { "type": "array", "uniqueItems": true, "default": [], "items": { "$ref": "#/$defs/sideEffect" } },
    "data_inputs": { "type": "array", "default": [], "items": { "$ref": "#/$defs/dataInput" } },
    "effective_sensitivity": { "$ref": "#/$defs/sensitivity" },
    "egress_approvals": { "type": "array", "maxItems": 32, "default": [], "items": { "$ref": "#/$defs/egressApproval" } },
    "proof": { "$ref": "#/$defs/stringArray", "default": [] },
    "stop_conditions": { "$ref": "#/$defs/stringArray", "default": [] },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "uuidv7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "providerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "capabilityIdArray": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "providerIdArray": { "type": "array", "items": { "$ref": "#/$defs/providerId" }, "uniqueItems": true },
    "providerAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "capabilities"],
      "properties": {
        "provider_id": { "$ref": "#/$defs/providerId" },
        "capabilities": { "$ref": "#/$defs/capabilityIdArray" }
      }
    },
    "sideEffect": { "enum": ["project-file-write", "workspace-file-write", "credential-use", "destructive-action", "paid-external-action", "production-data-write", "external-message", "issue-write", "pull-request-write", "purchase", "external-account-mutation", "deployment", "live-data-write"] },
    "dataInput": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_alias", "category", "sensitivity"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "source_alias": { "$ref": "#/$defs/slug" },
        "category": { "$ref": "#/$defs/slug" },
        "sensitivity": { "$ref": "#/$defs/sensitivity" }
      }
    },
    "egressApproval": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "approval_id", "route_id", "provider_id", "approved_at", "expires_at", "destination", "destination_id", "source_aliases", "data_categories", "effective_sensitivity", "disclosed_fields", "purpose", "retention", "further_calls_allowed", "content_digest"],
      "properties": {
        "schema_version": { "const": 1 },
        "approval_id": { "$ref": "#/$defs/uuidv7" },
        "route_id": { "$ref": "#/$defs/uuidv7" },
        "provider_id": { "$ref": "#/$defs/providerId" },
        "approved_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "destination": { "enum": ["host-model", "mcp-connector", "research-provider", "external-skill", "local-process", "external-api"] },
        "destination_id": { "$ref": "#/$defs/destinationIdentity" },
        "source_aliases": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "data_categories": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "effective_sensitivity": { "$ref": "#/$defs/sensitivity" },
        "disclosed_fields": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "retention": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "further_calls_allowed": { "type": "boolean" },
        "content_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "destinationIdentity": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$" }
  }
}
