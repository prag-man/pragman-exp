{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragman.dev/schemas/eval-candidate.schema.json",
  "title": "Content-free real-failure evaluation candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "timestamp", "skill_id", "skill_digest", "corpus_id", "source_event_digests", "failure_codes", "redacted_artifact_alias", "redacted_artifact_digest", "approval_status", "storage_scope", "append_only"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "$ref": "#/$defs/uuidv7" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "skill_id": { "$ref": "#/$defs/namespacedId" },
    "skill_digest": { "$ref": "#/$defs/sha256" },
    "corpus_id": { "$ref": "#/$defs/slug" },
    "source_event_digests": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "recommendation_digest": { "$ref": "#/$defs/sha256" },
    "failure_codes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "redacted_artifact_alias": { "$ref": "#/$defs/alias" },
    "redacted_artifact_digest": { "$ref": "#/$defs/sha256" },
    "approval_status": { "const": "pending" },
    "storage_scope": { "const": "local" },
    "append_only": { "const": true }
  },
  "$defs": {
    "secretFree": { "type": "string", "not": { "pattern": "(?:sk-(?:proj-)?[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9_]{20,}|AKIA[A-Z0-9]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{20,})" } },
    "slug": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }] },
    "namespacedId": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?$" }] },
    "alias": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }] },
    "uuidv7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
