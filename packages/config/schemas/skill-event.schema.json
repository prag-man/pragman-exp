{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragman.dev/schemas/skill-event.schema.json",
  "title": "Privacy-safe local Pragman skill lifecycle event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "invocation_id", "timestamp", "event_type",
    "skill_id", "skill_version", "skill_digest", "skill_type",
    "host", "host_version", "model", "model_version", "harness_version",
    "invocation_mode", "session_id", "route_id", "eval_id", "case_id", "trial_id",
    "provider", "ablation_arm", "trigger_expected", "trigger_actual", "provider_digest",
    "eval_corpus_digest", "trial_policy_digest", "status", "outcome_code", "duration_ms",
    "tool_calls", "retries", "rework_cycles", "verification_checks", "verification_passes",
    "observation_source", "source_aliases", "storage_scope", "append_only"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/uuidv7" },
    "invocation_id": { "$ref": "#/$defs/uuidv7" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "event_type": { "enum": ["eligible", "invoked", "completed", "cancelled", "verified"] },
    "skill_id": { "$ref": "#/$defs/namespacedId" },
    "skill_version": { "$ref": "#/$defs/safeVersion" },
    "skill_digest": { "$ref": "#/$defs/sha256" },
    "skill_type": { "enum": ["capability", "preference"] },
    "host": { "$ref": "#/$defs/slug" },
    "host_version": { "$ref": "#/$defs/safeVersion" },
    "model": { "$ref": "#/$defs/safeModel" },
    "model_version": { "$ref": "#/$defs/safeVersion" },
    "harness_version": { "$ref": "#/$defs/safeVersion" },
    "invocation_mode": { "enum": ["model", "user", "router", "host", "eval"] },
    "session_id": { "$ref": "#/$defs/nullableAlias" },
    "route_id": { "oneOf": [{ "$ref": "#/$defs/uuidv7" }, { "type": "null" }] },
    "eval_id": { "$ref": "#/$defs/nullableAlias" },
    "case_id": { "$ref": "#/$defs/nullableAlias" },
    "trial_id": { "$ref": "#/$defs/nullableAlias" },
    "provider": { "oneOf": [{ "$ref": "#/$defs/providerId" }, { "type": "null" }] },
    "ablation_arm": { "enum": ["skill-on", "skill-off", "production", null] },
    "trigger_expected": { "type": ["boolean", "null"] },
    "trigger_actual": { "type": ["boolean", "null"] },
    "provider_digest": { "$ref": "#/$defs/nullableSha256" },
    "eval_corpus_digest": { "$ref": "#/$defs/nullableSha256" },
    "trial_policy_digest": { "$ref": "#/$defs/nullableSha256" },
    "status": { "enum": ["succeeded", "partial", "failed", "cancelled", "handoff-required", null] },
    "outcome_code": { "$ref": "#/$defs/nullableSlug" },
    "duration_ms": { "$ref": "#/$defs/counter" },
    "tool_calls": { "$ref": "#/$defs/counter" },
    "retries": { "$ref": "#/$defs/counter" },
    "rework_cycles": { "$ref": "#/$defs/counter" },
    "verification_checks": { "$ref": "#/$defs/counter" },
    "verification_passes": { "$ref": "#/$defs/counter" },
    "observation_source": { "enum": ["router", "host-adapter", "cli", "eval-runner", "user-report"] },
    "source_aliases": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/alias" } },
    "storage_scope": { "const": "local" },
    "append_only": { "const": true }
  },
  "allOf": [
    {
      "if": { "properties": { "invocation_mode": { "const": "eval" } } },
      "then": {
        "properties": {
          "eval_id": { "$ref": "#/$defs/alias" },
          "case_id": { "$ref": "#/$defs/alias" },
          "trial_id": { "$ref": "#/$defs/alias" },
          "provider": { "$ref": "#/$defs/providerId" },
          "ablation_arm": { "enum": ["skill-on", "skill-off"] },
          "trigger_expected": { "type": "boolean" },
          "trigger_actual": { "type": "boolean" },
          "provider_digest": { "$ref": "#/$defs/sha256" },
          "eval_corpus_digest": { "$ref": "#/$defs/sha256" },
          "trial_policy_digest": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  ],
  "$defs": {
    "secretFree": { "type": "string", "not": { "pattern": "(?:sk-(?:proj-)?[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9_]{20,}|AKIA[A-Z0-9]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{20,})" } },
    "slug": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }] },
    "nullableSlug": { "oneOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
    "namespacedId": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?$" }] },
    "providerId": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" }] },
    "alias": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }] },
    "nullableAlias": { "oneOf": [{ "$ref": "#/$defs/alias" }, { "type": "null" }] },
    "safeVersion": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$" }] },
    "safeModel": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$" }] },
    "uuidv7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
