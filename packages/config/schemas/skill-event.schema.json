{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragman.dev/schemas/skill-event.schema.json",
  "title": "Privacy-safe local Pragman skill event",
  "description": "Append-only local metrics. Raw prompts, outputs, transcript content, and secrets are not valid fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "timestamp", "skill_id", "skill_version", "skill_digest", "skill_type", "host", "host_version", "model", "model_version", "harness_version", "event_type", "invocation_mode", "trigger_expected", "trigger_actual", "outcome", "status", "latency_ms", "tool_calls", "retries", "rework_cycles", "verification_checks", "verification_passes", "provider", "ablation_arm", "source_aliases", "storage_scope", "append_only"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/uuidv7" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "skill_id": { "$ref": "#/$defs/namespacedId" },
    "skill_version": { "$ref": "#/$defs/safeVersion" },
    "skill_digest": { "$ref": "#/$defs/sha256" },
    "skill_type": { "enum": ["capability", "preference"] },
    "host": { "$ref": "#/$defs/slug" },
    "host_version": { "$ref": "#/$defs/safeVersion" },
    "model": { "$ref": "#/$defs/safeModel" },
    "model_version": { "$ref": "#/$defs/safeVersion" },
    "harness_version": { "$ref": "#/$defs/safeVersion" },
    "session_id": { "$ref": "#/$defs/alias" },
    "route_id": { "$ref": "#/$defs/uuidv7" },
    "eval_id": { "$ref": "#/$defs/alias" },
    "case_id": { "$ref": "#/$defs/alias" },
    "trial_id": { "$ref": "#/$defs/alias" },
    "event_type": { "enum": ["discovered", "eligible", "invoked", "completed", "failed", "cancelled", "verified"] },
    "invocation_mode": { "enum": ["model", "user", "router"] },
    "trigger_expected": { "type": "boolean" },
    "trigger_actual": { "type": "boolean" },
    "outcome": { "$ref": "#/$defs/slug" },
    "status": { "enum": ["succeeded", "partial", "failed", "cancelled", "handoff-required"] },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "tool_calls": { "type": "integer", "minimum": 0 },
    "retries": { "type": "integer", "minimum": 0 },
    "rework_cycles": { "type": "integer", "minimum": 0 },
    "verification_checks": { "type": "integer", "minimum": 0 },
    "verification_passes": { "type": "integer", "minimum": 0 },
    "provider": { "$ref": "#/$defs/providerId" },
    "ablation_arm": { "enum": ["skill-on", "skill-off", "production"] },
    "source_aliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/alias" } },
    "storage_scope": { "const": "local" },
    "append_only": { "const": true }
  },
  "$defs": {
    "secretFree": { "type": "string", "not": { "pattern": "(?:sk-(?:proj-)?[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9_]{20,}|AKIA[A-Z0-9]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{20,})" } },
    "slug": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }] },
    "namespacedId": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?$" }] },
    "providerId": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" }] },
    "alias": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }] },
    "safeVersion": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$" }] },
    "safeModel": { "allOf": [{ "$ref": "#/$defs/secretFree" }, { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$" }] },
    "uuidv7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
