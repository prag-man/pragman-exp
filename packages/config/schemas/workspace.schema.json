{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragman.dev/schemas/workspace.schema.json",
  "title": "Pragman workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "name", "root", "context_sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "workspace_id": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "pattern": "^/", "minLength": 2 },
    "context_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/contextSource" },
      "uniqueItems": true,
      "$comment": "merge: ordered-set"
    },
    "description": { "type": "string" },
    "tools": { "type": "array", "default": [], "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "workflows": { "type": "array", "default": [], "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "sensitivity": { "$ref": "#/$defs/sensitivity", "default": "internal" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
    "contextSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "description", "sensitivity"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "enum": ["file", "directory", "url", "connector", "session", "manual"] },
        "uri": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sensitivity": { "$ref": "#/$defs/sensitivity" },
        "scope": { "type": "array", "default": [], "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "retrieval_hints": { "type": "array", "default": [], "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "freshness_days": { "type": ["integer", "null"], "minimum": 0, "default": null }
      }
    }
  }
}
