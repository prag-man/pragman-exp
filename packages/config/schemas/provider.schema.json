{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragman.dev/schemas/provider.schema.json",
  "title": "Pragman provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source", "source_version", "trust", "capabilities", "host_support", "invoke", "context_policy", "side_effects", "workflow_weight", "result_contract"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/providerId" },
    "source": { "$ref": "#/$defs/providerSource" },
    "source_version": { "type": "string", "minLength": 1 },
    "trust": { "enum": ["bundled", "curated", "workspace-approved", "discovered"] },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "host_support": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "invoke": { "$ref": "#/$defs/invoke" },
    "context_policy": { "$ref": "#/$defs/contextPolicy" },
    "side_effects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sideEffect" } },
    "workflow_weight": { "enum": ["light", "standard", "heavy"] },
    "result_contract": { "$ref": "#/$defs/slug" },
    "requires": { "type": "array", "default": [], "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:.-]*$" } },
    "strengths": { "type": "array", "default": [], "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "best_for": { "type": "array", "default": [], "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "avoid_when": { "type": "array", "default": [], "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "compatibility": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "source_version": { "type": "string", "minLength": 1 },
        "hosts": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "codex": { "type": "string", "minLength": 1 },
            "claude-code": { "type": "string", "minLength": 1 },
            "cursor": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evaluation_confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "providerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "skillId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?$" },
    "providerSource": {
      "oneOf": [
        { "$ref": "#/$defs/slug" },
        { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" }
      ]
    },
    "sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
    "sideEffect": {
      "enum": ["read-files", "run-commands", "project-file-write", "remote-egress", "external-message", "issue-write", "pull-request-write", "purchase", "external-account-mutation", "deploy", "production-data-write", "credential-access", "destructive"]
    },
    "egressDestination": { "enum": ["host-model", "mcp-connector", "research-provider", "external-skill", "local-process", "external-api"] },
    "invoke": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "skill_id"],
          "properties": { "kind": { "const": "native-skill" }, "skill_id": { "$ref": "#/$defs/providerId" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "skill_id", "prompt"],
          "properties": {
            "kind": { "const": "prompt-handoff" },
            "skill_id": { "$ref": "#/$defs/providerId" },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "executable", "arguments"],
          "properties": {
            "kind": { "const": "cli" },
            "executable": { "const": "pragman" },
            "arguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 128, "pattern": "^[^;&|`$<>\\n\\r]*$" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "instructions"],
          "properties": {
            "kind": { "const": "manual" },
            "instructions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
          }
        }
      ]
    },
    "contextPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_classes", "maximum_sensitivity", "accepts_redacted_excerpts"],
      "properties": {
        "accepted_classes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["task-contract", "context-summary", "redacted-excerpt"] }
        },
        "maximum_sensitivity": { "$ref": "#/$defs/sensitivity" },
        "accepts_redacted_excerpts": { "type": "boolean" }
      }
    }
  }
}
