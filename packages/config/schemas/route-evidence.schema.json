{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pragman.dev/schemas/route-evidence.schema.json",
  "title": "Pragman route evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_id", "decision", "provider_results", "started_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "route_id": { "$ref": "#/$defs/uuidv7" },
    "decision": { "$ref": "#/$defs/decision" },
    "provider_results": { "type": "array", "items": { "$ref": "#/$defs/providerResult" } },
    "started_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "finished_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "verification": { "type": "array", "default": [], "items": { "$ref": "#/$defs/verification" } },
    "user_feedback": { "enum": ["succeeded", "partial", "failed", "rolled-back"] },
    "sensitive_source_aliases": { "type": "array", "default": [], "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "providerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "uuidv7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "eligible", "selected_providers", "score_explanation", "approval_requirements"],
      "properties": {
        "lane": { "enum": ["fast", "standard", "deep", "operational"] },
        "eligible": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/providerId" } },
        "rejections": { "type": "array", "items": { "$ref": "#/$defs/explanation" } },
        "selected_providers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/providerId" } },
        "score_explanation": { "type": "array", "items": { "$ref": "#/$defs/explanation" } },
        "matched_rules": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "tie_break": { "type": ["string", "null"] },
        "approval_requirements": { "type": "array", "uniqueItems": true, "items": { "enum": ["route", "egress", "action", "target-specific", "host-action"] } },
        "error_state": { "type": ["string", "null"] },
        "fallback_state": { "type": ["string", "null"] }
      }
    },
    "explanation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": { "id": { "$ref": "#/$defs/providerId" }, "reason": { "type": "string" }, "score": { "type": "integer" } }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["check", "status"],
      "properties": { "check": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed", "skipped"] }, "evidence_ref": { "type": "string" } }
    },
    "providerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider_id", "route_id", "summary", "artifacts", "evidence", "verification", "error"],
      "properties": {
        "status": { "enum": ["succeeded", "partial", "failed", "cancelled", "handoff-required"] },
        "provider_id": { "$ref": "#/$defs/providerId" },
        "route_id": { "$ref": "#/$defs/uuidv7" },
        "summary": { "type": "string" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "retryable"],
          "properties": { "code": { "type": ["string", "null"] }, "retryable": { "type": "boolean", "default": false } }
        }
      }
    }
  }
}
