{
  "name": "@prag-man/pragman-exp",
  "version": "0.1.0-beta.0",
  "private": false,
  "description": "Adaptive, local-first control panel for high-quality agentic work across skills, hosts, and workspaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prag-man/pragman-exp.git"
  },
  "homepage": "https://github.com/prag-man/pragman-exp#readme",
  "bugs": {
    "url": "https://github.com/prag-man/pragman-exp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "bin": {
    "pragman": "dist/packages/cli/src/index.js"
  },
  "files": [
    "CONTRIBUTING.md",
    "SECURITY.md",
    "dist/",
    "docs/operations/",
    "evals/fixtures/",
    "evals/metrics/",
    "host-adapters/",
    "packages/config/schemas/",
    "providers/",
    "skills/",
    "scripts/"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "package:verify": "node scripts/verify-package.mjs --json",
    "eval": "node scripts/run-evals.mjs --mode skill-eval evals/fixtures/skill-events/baseline.json --observed evals/fixtures/skill-events/forward.json --output -",
    "evals": "node scripts/run-evals.mjs --mode skill-eval evals/fixtures/skill-events/baseline.json --observed evals/fixtures/skill-events/forward.json --output -"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
